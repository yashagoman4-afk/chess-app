<html><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com/">
<link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin="">
<link href="./chess-board_15_files/css2" rel="stylesheet">

<style>
  :root{
    --ink:#050708;
    --panel:#0A0D0E;
    --panel-2:#0E1114;
    --line:#161C1F;
    --dark:#0d1515;
    --light:#081515;
    --cyan:#00D9FF;
    --magenta:#FF006E;
    --accent:#00D9FF;
    --text:#E0FFFF;
    --muted:#00A8CC;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    background:var(--ink);
    color:var(--text);
    font-family:'Archivo',system-ui,sans-serif;
    padding:20px 16px 40px;
    -webkit-font-smoothing:antialiased;
  }
  .wrap{max-width:960px;margin:0 auto}

  header{
    display:flex;align-items:baseline;gap:12px;
    border-bottom:1px solid var(--line);
    padding-bottom:12px;margin-bottom:20px;flex-wrap:wrap;
  }
  h1{
    font-size:22px;font-weight:800;letter-spacing:-0.02em;text-transform:uppercase;
  }
  .sub{
    font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--muted);
    letter-spacing:0.08em;text-transform:uppercase;
  }

  .layout{display:flex;gap:24px;align-items:flex-start;flex-wrap:wrap}
  .boardcol{flex:1 1 380px;min-width:300px;max-width:560px}
  .sidecol{flex:1 1 260px;min-width:250px}

  /* ---- board ---- */
  .boardframe{
    display:grid;
    grid-template-columns:18px 1fr;
    grid-template-rows:1fr 18px;
    gap:4px;
  }
  .ranks,.files{
    display:grid;
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;color:var(--muted);
  }
  .ranks{grid-template-rows:repeat(8,1fr);align-items:center;justify-items:center}
  .files{grid-column:2;grid-template-columns:repeat(8,1fr);justify-items:center;align-items:center}

  .board{
    display:grid;
    grid-template-columns:repeat(8,1fr);
    grid-template-rows:repeat(8,1fr);
    aspect-ratio:1;width:100%;
    border:1px solid var(--line);
    user-select:none;touch-action:manipulation;
    position:relative;
    background-size:contain;
    background-repeat:no-repeat;
    background-position:center;
  }
  .sq{
    position:relative;display:flex;align-items:center;justify-content:center;
    cursor:pointer;border:0;padding:0;font-size:min(8vw,42px);
    line-height:1;overflow:hidden;min-width:0;min-height:0;
    transition:all 0.15s ease-out;
  }
  .sq.d{background:#0a1314}
  .sq.l{background:#081515}
  .sq:focus-visible{outline:3px solid var(--magenta);outline-offset:-4px;z-index:3;box-shadow:inset 0 0 12px rgba(255,0,110,.3)}

  .pc{
    position:relative;z-index:2;pointer-events:none;
    font-weight:900;font-size:1.1em;letter-spacing:-0.08em;
    text-shadow:
      0 0 12px currentColor,
      0 0 24px currentColor,
      0 0 4px rgba(0,0,0,.8);
  }
  @keyframes enter{
    from{opacity:0;transform:scale(0.5) rotateY(180deg)}
    to{opacity:1;transform:scale(1) rotateY(0deg)}
  }
  @keyframes ultra-tilt{
    0%{transform:perspective(1200px) rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1)}
    10%{transform:perspective(1200px) rotateX(-6deg) rotateY(-8deg) rotateZ(4deg) scale(1.05)}
    20%{transform:perspective(1200px) rotateX(8deg) rotateY(10deg) rotateZ(-5deg) scale(1.06)}
    30%{transform:perspective(1200px) rotateX(-7deg) rotateY(-9deg) rotateZ(5deg) scale(1.05)}
    40%{transform:perspective(1200px) rotateX(6deg) rotateY(7deg) rotateZ(-4deg) scale(1.04)}
    50%{transform:perspective(1200px) rotateX(-4deg) rotateY(-5deg) rotateZ(3deg) scale(1.02)}
    65%{transform:perspective(1200px) rotateX(2deg) rotateY(3deg) rotateZ(-1deg) scale(1.01)}
    80%{transform:perspective(1200px) rotateX(-1deg) rotateY(-1deg) rotateZ(0.5deg) scale(1.005)}
    100%{transform:perspective(1200px) rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1)}
  }
  @keyframes hammer-swing{
    0%{
      transform:translate(-200px, -200px) rotate(-90deg) scale(0.8);
      opacity:0;
    }
    30%{
      transform:translate(-100px, -120px) rotate(-60deg) scale(1);
      opacity:1;
    }
    50%{
      transform:translate(-20px, -40px) rotate(-30deg) scale(1.05);
      opacity:1;
    }
    65%{
      transform:translate(30px, 20px) rotate(0deg) scale(1.1);
      opacity:1;
      filter:drop-shadow(0 0 40px #FF006E) drop-shadow(0 0 80px #FF006E);
    }
    75%{
      transform:translate(80px, 80px) rotate(30deg) scale(1);
      opacity:0.9;
      filter:drop-shadow(0 0 60px #FF006E);
    }
    90%{
      transform:translate(150px, 150px) rotate(60deg) scale(0.6);
      opacity:0.3;
    }
    100%{
      transform:translate(200px, 200px) rotate(90deg) scale(0);
      opacity:0;
    }
  }
  @keyframes shatter{
    0%{
      transform:translate(0, 0) scale(1);
      opacity:1;
    }
    70%{
      opacity:1;
    }
    100%{
      opacity:0;
    }
  }
  @keyframes fragment{
    0%{
      transform:translate(0, 0) scale(1);
      opacity:1;
    }
    100%{
      opacity:0;
    }
  }
  .fragment{
    position:absolute;
    font-size:inherit;
    animation:fragment 0.8s ease-out forwards;
    pointer-events:none;
  }
  @keyframes capture-cinema{
    0%{
      transform:scale(1) rotateX(0deg) rotateY(0deg);
      opacity:1;
      filter:brightness(1);
    }
    20%{
      transform:scale(1.1) rotateX(20deg) rotateY(20deg);
      opacity:1;
      filter:brightness(1.3);
    }
    40%{
      transform:scale(1.3) rotateX(45deg) rotateY(-45deg);
      opacity:1;
      filter:brightness(1.8) drop-shadow(0 0 20px #FF006E);
    }
    60%{
      transform:scale(0.8) rotateX(90deg) rotateY(180deg);
      opacity:0.7;
      filter:brightness(1.5) drop-shadow(0 0 40px #FF006E) drop-shadow(0 0 60px #00D9FF);
    }
    80%{
      transform:scale(0.3) rotateX(180deg) rotateY(360deg);
      opacity:0.3;
      filter:brightness(0.5) drop-shadow(0 0 80px #FF006E);
    }
    100%{
      transform:scale(0) rotateX(360deg) rotateY(720deg);
      opacity:0;
      filter:brightness(0) drop-shadow(0 0 0px #FF006E);
    }
  }
  .pc.captured{
    animation:capture-cinema 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  @keyframes king-destroy{
    0%{
      opacity:1;
      transform:scale(1) rotateX(0deg) rotateY(0deg) rotateZ(0deg);
      filter:drop-shadow(0 0 0px #FF006E);
    }
    15%{
      opacity:1;
      transform:scale(1.2) rotateX(30deg) rotateY(30deg) rotateZ(-20deg);
      filter:drop-shadow(0 0 20px #FF006E);
    }
    35%{
      opacity:1;
      transform:scale(1.4) rotateX(90deg) rotateY(-90deg) rotateZ(45deg);
      filter:drop-shadow(0 0 50px #FF006E) drop-shadow(0 0 80px #00D9FF) brightness(1.6);
    }
    50%{
      opacity:0.8;
      transform:scale(0.8) rotateX(180deg) rotateY(180deg) rotateZ(-90deg);
      filter:drop-shadow(0 0 80px #FF006E) brightness(1.2);
    }
    65%{
      opacity:0.3;
      transform:scale(0.4) rotateX(270deg) rotateY(270deg) rotateZ(-180deg);
      filter:drop-shadow(0 0 60px #FF006E) brightness(0.7);
    }
    85%{
      opacity:0.1;
      transform:scale(0.15) rotateX(360deg) rotateY(360deg) rotateZ(-360deg);
      filter:drop-shadow(0 0 40px #FF006E) brightness(0.3);
    }
    100%{
      opacity:0;
      transform:scale(0) rotateX(720deg) rotateY(720deg) rotateZ(-720deg);
      filter:drop-shadow(0 0 0px #FF006E) brightness(0);
    }
  }
  @keyframes shatter-piece-1{
    0%{transform:translate(0, 0) rotate(0deg) scale(1); opacity:1;}
    100%{transform:translate(-80px, -100px) rotate(360deg) scale(0); opacity:0;}
  }
  @keyframes shatter-piece-2{
    0%{transform:translate(0, 0) rotate(0deg) scale(1); opacity:1;}
    100%{transform:translate(80px, -100px) rotate(-360deg) scale(0); opacity:0;}
  }
  @keyframes shatter-piece-3{
    0%{transform:translate(0, 0) rotate(0deg) scale(1); opacity:1;}
    100%{transform:translate(-100px, 80px) rotate(360deg) scale(0); opacity:0;}
  }
  @keyframes shatter-piece-4{
    0%{transform:translate(0, 0) rotate(0deg) scale(1); opacity:1;}
    100%{transform:translate(100px, 80px) rotate(-360deg) scale(0); opacity:0;}
  }
  @keyframes aura-burst{
    0%{
      box-shadow:
        0 0 30px #00D9FF,
        0 0 60px #FF006E,
        inset 0 0 40px rgba(0,217,255,0.15);
      filter:brightness(1) drop-shadow(0 0 30px #00D9FF) drop-shadow(0 0 50px #FF006E);
    }
    30%{
      box-shadow:
        0 0 80px #00D9FF,
        0 0 130px #FF006E,
        0 0 180px #00D9FF,
        inset 0 0 80px rgba(0,217,255,0.3);
      filter:brightness(1.5) drop-shadow(0 0 70px #00D9FF) drop-shadow(0 0 110px #FF006E) drop-shadow(0 0 160px #00D9FF);
    }
    60%{
      box-shadow:
        0 0 70px #FF006E,
        0 0 140px #00D9FF,
        0 0 200px #FF006E,
        inset 0 0 70px rgba(255,0,110,0.2);
      filter:brightness(1.4) drop-shadow(0 0 80px #FF006E) drop-shadow(0 0 130px #00D9FF) drop-shadow(0 0 180px #FF006E);
    }
    85%{
      box-shadow:
        0 0 50px #00D9FF,
        0 0 100px #FF006E,
        inset 0 0 50px rgba(0,217,255,0.15);
      filter:brightness(1.2) drop-shadow(0 0 50px #00D9FF) drop-shadow(0 0 80px #FF006E);
    }
    100%{
      box-shadow:
        0 0 30px #00D9FF,
        0 0 60px #FF006E,
        inset 0 0 40px rgba(0,217,255,0.15);
      filter:brightness(1) drop-shadow(0 0 30px #00D9FF) drop-shadow(0 0 50px #FF006E);
    }
  }
  @keyframes piece-glow-smooth{
    0%{
      text-shadow:
        0 0 15px currentColor,
        0 0 30px currentColor,
        0 0 50px currentColor;
      filter:drop-shadow(0 0 25px currentColor) drop-shadow(0 0 50px currentColor) brightness(1.2);
    }
    35%{
      text-shadow:
        0 0 35px currentColor,
        0 0 70px currentColor,
        0 0 120px currentColor,
        0 0 170px currentColor;
      filter:drop-shadow(0 0 70px currentColor) drop-shadow(0 0 120px currentColor) drop-shadow(0 0 180px currentColor) brightness(1.6);
    }
    65%{
      text-shadow:
        0 0 30px currentColor,
        0 0 60px currentColor,
        0 0 100px currentColor,
        0 0 150px currentColor;
      filter:drop-shadow(0 0 60px currentColor) drop-shadow(0 0 110px currentColor) drop-shadow(0 0 170px currentColor) brightness(1.5);
    }
    100%{
      text-shadow:
        0 0 15px currentColor,
        0 0 30px currentColor,
        0 0 50px currentColor;
      filter:drop-shadow(0 0 25px currentColor) drop-shadow(0 0 50px currentColor) brightness(1.2);
    }
  }
  .board.mate{
    animation:ultra-tilt 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .board.mate::before{
    content:'';
    position:absolute;
    inset:50%;
    width:120px;
    height:120px;
    margin-left:-60px;
    margin-top:-60px;
    pointer-events:none;
    background-image:url('data:image/svg+xml;utf8,<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg"><defs><linearGradient id="metalGrad" x1="0%" y1="0%" x2="100%" y2="100%"><stop offset="0%" style="stop-color:%23FFB347;stop-opacity:1" /><stop offset="50%" style="stop-color:%23FF8C00;stop-opacity:1" /><stop offset="100%" style="stop-color:%23FF6347;stop-opacity:1" /></linearGradient><linearGradient id="headGrad" x1="0%" y1="0%" x2="0%" y2="100%"><stop offset="0%" style="stop-color:%23FFCC00;stop-opacity:1" /><stop offset="50%" style="stop-color:%23FFB347;stop-opacity:1" /><stop offset="100%" style="stop-color:%23FF8C00;stop-opacity:1" /></linearGradient><filter id="glow"><feGaussianBlur stdDeviation="2" result="coloredBlur"/><feMerge><feMergeNode in="coloredBlur"/><feMergeNode in="SourceGraphic"/></feMerge></filter></defs><g filter="url(%23glow)"><rect x="45" y="10" width="30" height="70" rx="4" fill="url(%23metalGrad)" opacity="0.9"/><ellipse cx="60" cy="8" rx="18" ry="6" fill="%23FFD700" opacity="0.8"/><ellipse cx="60" cy="82" rx="18" ry="6" fill="%23FF6347" opacity="0.6"/><rect x="20" y="85" width="80" height="28" rx="6" fill="url(%23headGrad)" opacity="0.95"/><ellipse cx="60" cy="85" rx="42" ry="8" fill="%23FFCC00" opacity="0.7"/><ellipse cx="60" cy="113" rx="42" ry="8" fill="%23CC6600" opacity="0.8"/><rect x="25" y="88" width="70" height="20" rx="4" fill="%23FFD700" opacity="0.4"/><circle cx="35" cy="98" r="3" fill="%23FFFFFF" opacity="0.6"/><circle cx="60" cy="95" r="3" fill="%23FFFFFF" opacity="0.6"/><circle cx="85" cy="100" r="3" fill="%23FFFFFF" opacity="0.6"/></g></svg>');
    background-size:contain;
    background-repeat:no-repeat;
    background-position:center;
    animation:hammer-swing 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index:10;
    filter:drop-shadow(0 0 20px #FF006E) drop-shadow(0 0 40px #FF006E);
  }
  .board.mate .pc{
    animation:piece-glow-smooth 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .board.mate .pc.king-destroy{
    animation:king-destroy 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  .board.mate .aura{
    position:absolute;
    inset:-20px;
    pointer-events:none;
    border-radius:8px;
    animation:aura-burst 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    z-index:-1;
  }
  .board:not(.mate) .pc.moved{
    animation:enter 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes enter{
    from{opacity:0;transform:scale(0.5) rotateY(180deg)}
    to{opacity:1;transform:scale(1) rotateY(0deg)}
  }
  .pc.w{
    color:#E8E8E8;
    text-shadow:
      0 0 4px #00D9FF,
      0 0 8px #00D9FF,
      0 0 12px #00D9FF,
      0 0 18px #00D9FF,
      0 0 28px #00D9FF;
    filter:drop-shadow(0 0 12px #00D9FF) drop-shadow(0 0 24px #00D9FF) drop-shadow(0 0 40px #00D9FF) brightness(1.1);
  }
  .pc.b{
    color:#E8E8E8;
    text-shadow:
      0 0 4px #FF1493,
      0 0 8px #FF1493,
      0 0 12px #FF1493,
      0 0 18px #FF1493,
      0 0 28px #FF1493;
    filter:drop-shadow(0 0 12px #FF1493) drop-shadow(0 0 24px #FF1493) drop-shadow(0 0 40px #FF1493) brightness(1.1);
  }

  .sq.sel::after{
    content:'';position:absolute;inset:0;background:var(--magenta);opacity:.5;z-index:1;
    box-shadow:inset 0 0 16px var(--magenta);animation:pulse 1.2s infinite;
  }
  @keyframes pulse{
    0%,100%{box-shadow:inset 0 0 16px var(--magenta)}
    50%{box-shadow:inset 0 0 24px var(--magenta)}
  }
  .sq.last::after{
    content:'';position:absolute;inset:0;background:var(--cyan);opacity:.3;z-index:1;
  }
  .sq.chk::after{
    content:'';position:absolute;inset:0;background:var(--magenta);opacity:.6;z-index:1;
    animation:warning 0.6s infinite;
  }
  @keyframes warning{
    0%,100%{opacity:.6}
    50%{opacity:.9}
  }
  .dot{
    position:absolute;width:26%;height:26%;border-radius:50%;
    background:var(--cyan);z-index:1;opacity:.4;
    box-shadow:0 0 6px var(--cyan);
  }
  .ring{
    position:absolute;inset:6%;border-radius:50%;
    border:3px solid var(--cyan);z-index:1;
    box-shadow:0 0 8px var(--cyan);
  }

  /* ---- side panel ---- */
  .status{
    background:var(--panel);border:1px solid var(--line);
    padding:12px 14px;margin-bottom:14px;
  }
  .status .who{
    font-family:'IBM Plex Mono',monospace;font-size:10px;
    letter-spacing:.12em;text-transform:uppercase;color:var(--muted);
  }
  .status .msg{font-size:17px;font-weight:600;margin-top:3px;color:var(--cyan)}
  .status.alert .msg{color:var(--magenta);text-shadow:0 0 8px var(--magenta)}

  .modes{display:flex;gap:0;margin-bottom:14px;border:1px solid var(--line)}
  .modes button{
    flex:1;background:var(--panel);color:var(--muted);border:1px solid var(--line);
    padding:9px 6px;cursor:pointer;font-family:'Archivo',sans-serif;
    font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
    transition:all 0.2s;
  }
  .modes button:hover{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 8px rgba(0,217,255,.3)}
  .modes button[aria-pressed="true"]{
    background:linear-gradient(135deg, var(--cyan), var(--magenta));
    color:#000;border-color:var(--cyan);
    box-shadow:0 0 16px var(--cyan);font-weight:700;
  }
  .modes button:focus-visible{outline:2px solid var(--magenta);outline-offset:2px}
  
  .themes{margin-bottom:14px;display:flex;align-items:center;gap:8px;}
  .themes label{font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--muted);text-transform:uppercase;font-weight:600;}
  .themes select{background:var(--panel);color:var(--text);border:1px solid var(--line);padding:6px 8px;font-size:12px;cursor:pointer;font-family:'Archivo',sans-serif;}
  .themes select:hover{border-color:var(--cyan)}

  /* scoresheet — the signature piece */
  .sheet{
    background:var(--panel);border:1px solid var(--line);margin-bottom:14px;
  }
  .sheet h2{
    font-family:'IBM Plex Mono',monospace;font-size:10px;font-weight:600;
    letter-spacing:.14em;text-transform:uppercase;color:var(--muted);
    padding:9px 12px;border-bottom:1px solid var(--line);
  }
  .sheetbody{max-height:260px;overflow-y:auto}
  table{width:100%;border-collapse:collapse;font-family:'IBM Plex Mono',monospace;font-size:13px}
  tr{border-bottom:1px solid rgba(46,57,62,.6)}
  tr:last-child{border-bottom:0}
  td{padding:5px 10px}
  td.n{width:34px;color:var(--muted);font-size:11px;text-align:right;background:var(--panel-2)}
  td.mv{width:calc(50% - 17px)}
  .empty{padding:14px 12px;color:var(--muted);font-size:12px;font-family:'IBM Plex Mono',monospace}

  .taken{
    display:flex;justify-content:space-between;gap:10px;margin-bottom:14px;
    font-size:19px;line-height:1.1;min-height:24px;
  }
  .taken div{flex:1}
  .taken .b{color:#79858A}
  .taken .w{color:#C9C3B4;text-align:right}

  .acts{display:flex;gap:8px}
  .acts button{
    flex:1;background:var(--panel);border:1px solid var(--line);color:var(--text);
    padding:10px;cursor:pointer;font-family:'Archivo',sans-serif;
    font-size:11px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;
    transition:all 0.2s;
  }
  .acts button:hover{border-color:var(--cyan);color:var(--cyan);box-shadow:0 0 12px rgba(0,217,255,.4)}
  .acts button:focus-visible{outline:2px solid var(--magenta);outline-offset:2px}

  /* promotion */
  .promo{
    position:fixed;inset:0;background:rgba(10,14,16,.82);
    display:none;align-items:center;justify-content:center;z-index:50;
  }
  .promo.on{display:flex}
  .promo .card{background:var(--panel);border:2px solid var(--cyan);padding:18px;box-shadow:0 0 24px rgba(0,217,255,.4)}
  .promo p{
    font-family:'IBM Plex Mono',monospace;font-size:10px;letter-spacing:.14em;
    text-transform:uppercase;color:var(--cyan);margin-bottom:12px;text-align:center;text-shadow:0 0 8px rgba(0,217,255,.5);
  }
  .promo .row{display:flex;gap:6px}
  .promo button{
    width:56px;height:56px;font-size:34px;background:var(--panel-2);
    border:2px solid var(--muted);cursor:pointer;color:var(--text);line-height:1;
    transition:all 0.2s;
  }
  .promo button:hover{border-color:var(--magenta);box-shadow:0 0 12px var(--magenta)}

  @media (max-width:700px){
    .sq{font-size:min(10vw,40px)}
    h1{font-size:19px}
  }
  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>

