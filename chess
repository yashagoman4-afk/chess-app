 aria-label="c5"></button><button class="sq l" data-i="27" aria-label="d5"></button><button class="sq d" data-i="28" aria-label="e5"></button><button class="sq l" data-i="29" aria-label="f5"></button><button class="sq d" data-i="30" aria-label="g5"></button><button class="sq l" data-i="31" aria-label="h5"></button><button class="sq l" data-i="32" aria-label="a4"></button><button class="sq d" data-i="33" aria-label="b4"></button><button class="sq l" data-i="34" aria-label="c4"></button><button class="sq d" data-i="35" aria-label="d4"></button><button class="sq l" data-i="36" aria-label="e4"></button><button class="sq d" data-i="37" aria-label="f4"></button><button class="sq l" data-i="38" aria-label="g4"></button><button class="sq d" data-i="39" aria-label="h4"></button><button class="sq d" data-i="40" aria-label="a3"></button><button class="sq l" data-i="41" aria-label="b3"></button><button class="sq d" data-i="42" aria-label="c3"></button><button class="sq l" data-i="43" aria-label="d3"></button><button class="sq d" data-i="44" aria-label="e3"></button><button class="sq l" data-i="45" aria-label="f3"></button><button class="sq d" data-i="46" aria-label="g3"></button><button class="sq l" data-i="47" aria-label="h3"></button><button class="sq l" data-i="48" aria-label="a2"><span class="pc w">♟</span></button><button class="sq d" data-i="49" aria-label="b2"><span class="pc w">♟</span></button><button class="sq l" data-i="50" aria-label="c2"><span class="pc w">♟</span></button><button class="sq d" data-i="51" aria-label="d2"><span class="pc w">♟</span></button><button class="sq l" data-i="52" aria-label="e2"><span class="pc w">♟</span></button><button class="sq d" data-i="53" aria-label="f2"><span class="pc w">♟</span></button><button class="sq l" data-i="54" aria-label="g2"><span class="pc w">♟</span></button><button class="sq d" data-i="55" aria-label="h2"><span class="pc w">♟</span></button><button class="sq d" data-i="56" aria-label="a1"><span class="pc w">♜</span>